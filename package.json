{
  "name": "link-chart-studio",
  "productName": "Link Chart Studio",
  "version": "1.0.0",
  "description": "Link chart editor with infrastructure transforms",
  "author": "caselka",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node -e \"require('fs').mkdirSync('vendor',{recursive:true});require('fs').copyFileSync('node_modules/vis-network/standalone/umd/vis-network.min.js','vendor/vis-network.min.js')\"",
    "dist": "npm run vendor && electron-builder --win nsis"
  },
  "build": {
    "appId": "io.github.caselka.linkchartstudio",
    "productName": "Link Chart Studio",
    "files": [
      "main.js",
      "index.html",
      "vendor/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Link Chart Studio"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vis-network": "^9.1.9"
  }
}
